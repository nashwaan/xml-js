{
  "name": "@kalidasya/xml-js",
  "version": "1.0.0",
  "description": "A convertor between XML text and Javascript object / JSON text.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalidasya/xml-js.git"
  },
  "author": "Yousuf Almarzooqi <ysf953@gmail.com>",
  "contributors": [
    "Tamas Kende <kende.tamas@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kalidasya/xml-js/issues"
  },
  "homepage": "https://github.com/kalidasya/xml-js#readme",
  "keywords": [
    "XML",
    "xml",
    "js",
    "JSON",
    "json",
    "cdata",
    "CDATA",
    "doctype",
    "processing instruction",
    "Javascript",
    "js2xml",
    "json2xml",
    "xml2js",
    "xml2json",
    "transform",
    "transformer",
    "transforming",
    "transformation",
    "convert",
    "convertor",
    "converting",
    "conversion",
    "parse",
    "parser",
    "parsing"
  ],
  "main": "lib/index.js",
  "bin": {
    "xml-js": "bin/cli.js"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "webpack --mode=production",
    "jest": "jest --config=test/jest.conf.js --runInBand --detectOpenHandles",
    "open-help": "biased-opener --help",
    "prepublish": "npm run test",
    "test": "npm run jest && npm run test:types",
    "test:types": "tsc -p ./types",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@babel/core": "^7.27.4",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.1",
    "jest-cli": "^30.5.1",
    "jest-html-reporter": "^4.4.0",
    "jest-mock-process": "^2.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "typescript": "^5.9.3",
    "unminified-webpack-plugin": "^3.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "semi": true
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
